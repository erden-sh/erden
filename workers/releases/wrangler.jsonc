// The Erden release Worker (src/index.ts, schema.sql): the install entry point, download redirects and the CLI's update
// endpoint, on erden.sh paths no other Worker claims. The top level is for local development (`pnpm run dev:releases`
// with a local D1); `env.production` is what the owner deploys, after creating the D1 database and putting its ID
// below. Nothing here is deployed by CI.
//
// Observability (Workers Logs) is off: invocation logs would keep request details this Worker promises not to keep.
{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "erden-releases",
    "main": "./src/index.ts",
    "compatibility_date": "2026-10-01",
    "workers_dev": false,
    "preview_urls": false,
    "observability": { "enabled": false },
    "triggers": { "crons": ["23 3 * * *"] },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "erden-releases",
            "database_id": "00000000-0000-0000-0000-000000000000",
        },
    ],
    "env": {
        "production": {
            "name": "erden-releases",
            "observability": { "enabled": false },
            // GITHUB_TOKEN (a secret) is required when ENVIRONMENT is production.
            "vars": { "ENVIRONMENT": "production" },
            "routes": [
                { "pattern": "erden.sh/install", "zone_name": "erden.sh" },
                { "pattern": "erden.sh/install.ps1", "zone_name": "erden.sh" },
                { "pattern": "erden.sh/install/*", "zone_name": "erden.sh" },
                { "pattern": "erden.sh/download/*", "zone_name": "erden.sh" },
                { "pattern": "erden.sh/updates/*", "zone_name": "erden.sh" },
            ],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "erden-releases",
                    "database_id": "c7a3bca7-9008-4a70-a3c6-48ff34bc6f18",
                },
            ],
        },
    },
}
