PREFIX ex: <https://example.test/onto#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?c ?b WHERE { ?c rdfs:label ?l . BIND (STRBEFORE(STR(?l), " ") AS ?b) FILTER (CONTAINS(STR(?l), "s") || STRSTARTS(STR(?l), "C") || STRENDS(STR(?l), "x")) } ORDER BY ?c ?b
