{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true
    },
    "include": [
        "apps/**/*.ts",
        "packages/**/*.ts",
        "reasoner/**/*.ts",
        "shacl/**/*.ts",
        "workers/**/*.ts",
        "vitest.config.ts"
    ],
    "exclude": ["**/node_modules", "workers/**/.wrangler"]
}
